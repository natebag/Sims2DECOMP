#!/bin/bash
# Pre-commit hook: verify new match files actually match the DOL.
#
# Outcomes per file:
#   MATCH                -> allowed through
#   MISMATCH/SIZE_MISMATCH -> auto-moved to src/wip/version_diff/ (preserves work)
#   COMPILE_FAIL         -> BLOCKED (broken source contaminates the build)
#   HEADER_UNPARSEABLE   -> BLOCKED (forces canonical header format)
#   FAKE (asm/byte inj.) -> BLOCKED entirely
#
# File filter: src/matched/**/*.cpp ONLY. Files in src/wip/, src/asm_decomp/,
# src/asm_wrappers/, etc. are not verified by this hook.
#
# Emergency bypass: SKIP_VERIFY=1 git commit ...
#   (logged loudly to stderr; do not use casually)

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# ---------------------------------------------------------------------------
# Emergency bypass
# ---------------------------------------------------------------------------
if [ "${SKIP_VERIFY:-}" = "1" ]; then
    echo -e "${RED}[pre-commit] WARNING: SKIP_VERIFY=1 -- match-file verification BYPASSED${NC}" >&2
    echo -e "${RED}[pre-commit] This bypass is logged. Do not use without justification.${NC}" >&2
    REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo .)"
    LOG="$REPO_ROOT/.git/hooks/bypass.log"
    {
        echo "--"
        echo "ts=$(date -Iseconds)"
        echo "user=${USER:-unknown}"
        echo "staged=$(git diff --cached --name-only | tr '\n' ',' | sed 's/,$//')"
    } >> "$LOG" 2>/dev/null || true
    exit 0
fi

BLOCKED=0
CHECKED=0
MOVED=0

# Get staged new/modified .cpp files in src/matched/ only.
# (Excludes src/wip/, src/asm_decomp/, src/asm_wrappers/, etc.)
FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '^src/matched/.*\.cpp$' || true)

if [ -z "$FILES" ]; then
    exit 0
fi

echo -e "${YELLOW}[pre-commit] Checking match files...${NC}"

# ---------------------------------------------------------------------------
# QA-RULE #3: Address collision gate
# Block commits that would create a second match_*.cpp at an address already
# matched elsewhere in src/matched/** or src/wip/**. Catches the failure mode
# from the Session 11 clone_stubs.py incident where a tool scoped its own
# glob too narrowly and re-created 64 dupes.
# Only checks NEW files (--diff-filter=A); rename/rewrite existing OK.
# ---------------------------------------------------------------------------
readarray -t NEW_MATCH_FILES < <(git diff --cached --name-only --diff-filter=A | grep '^src/matched/.*/match_.*\.cpp$' || true)
if [ ${#NEW_MATCH_FILES[@]} -gt 0 ]; then
    if py -3 tools/check_addr_collision.py "${NEW_MATCH_FILES[@]}" 2>/dev/null | grep -q '^DUPE '; then
        echo -e "${RED}[pre-commit] BLOCKED: address collision detected${NC}" >&2
        py -3 tools/check_addr_collision.py "${NEW_MATCH_FILES[@]}" 2>/dev/null | while IFS= read -r line; do
            if [[ "$line" == DUPE* ]]; then
                # Format: DUPE <file> 0xADDR <existing1> <existing2>...
                new_file=$(echo "$line" | awk '{print $2}')
                addr=$(echo "$line" | awk '{print $3}')
                existing=$(echo "$line" | cut -d' ' -f4-)
                echo -e "${RED}  DUPE: $new_file ($addr)${NC}" >&2
                for e in $existing; do
                    echo -e "${RED}    already matched: $e${NC}" >&2
                done
            fi
        done
        echo -e "${RED}[pre-commit] Delete the new file(s) OR the existing match(es) before committing.${NC}" >&2
        echo -e "${RED}[pre-commit] Bypass: SKIP_VERIFY=1 git commit ... (logged to .git/hooks/bypass.log)${NC}" >&2
        exit 1
    fi
fi

mkdir -p src/wip/version_diff

# ---------------------------------------------------------------------------
# Helper: parse addr + size from a match file's first 5 lines.
# Recognises:
#   // 0x8003FB0C EGlobal::HouseNameText (112B)
#   // 0x8003FB0C EGlobal::HouseNameText (112b)
#   // 0x8003FB0C ... 112 bytes
#   // Address: 0x80159D88 | Size: 12 bytes
#   /* Func at 0x... (12B) */
# Sets globals ADDR and SIZE; empty if not found.
# ---------------------------------------------------------------------------
parse_header() {
    local file="$1"
    ADDR=""
    SIZE=""
    local head_text
    head_text=$(head -5 "$file")

    # Find first 0xXXXXXXXX (8 hex digits)
    ADDR=$(echo "$head_text" | grep -oE '0x[0-9A-Fa-f]{8}' | head -1)

    # Try several size formats:
    # "(12B)", "(12b)" -> bare bytes form
    SIZE=$(echo "$head_text" | grep -oE '\(([0-9]+)[Bb]\)' | head -1 | grep -oE '[0-9]+')
    if [ -z "$SIZE" ]; then
        # "12 bytes" / "12 Bytes"
        SIZE=$(echo "$head_text" | grep -oE '[0-9]+ [Bb]ytes' | head -1 | grep -oE '[0-9]+')
    fi
    if [ -z "$SIZE" ]; then
        # "Size: 12" or "Size:12"
        SIZE=$(echo "$head_text" | grep -oE 'Size:[[:space:]]*[0-9]+' | head -1 | grep -oE '[0-9]+')
    fi
    if [ -z "$SIZE" ]; then
        # "(12 bytes)" or "(12 B)" -- size+space+B
        SIZE=$(echo "$head_text" | grep -oE '\(([0-9]+)[[:space:]]*[Bb]' | head -1 | grep -oE '[0-9]+')
    fi
}

for f in $FILES; do
    # Check for byte injection / naked functions / GCC-style __asm__ (FAKE -- block)
    if grep -qE '__asm__|__attribute__\(\(naked\)\)|\.byte |\.long 0x' "$f" 2>/dev/null; then
        echo -e "${RED}BLOCKED (FAKE): $f contains byte injection or naked function${NC}"
        BLOCKED=$((BLOCKED + 1))
        continue
    fi

    # __builtin_unreachable + __attribute__((noreturn)) — Family A cheat tell
    # from gen_ctor_matches.py (deleted, but block regenerated copies). The
    # noreturn attribute suppresses the compiler-generated function body so
    # an inline-asm block is the only thing emitted. Audit note a733a05b.
    if grep -q '__builtin_unreachable' "$f" 2>/dev/null; then
        echo -e "${RED}BLOCKED (FAKE): $f contains __builtin_unreachable -- used to mask byte injection${NC}"
        BLOCKED=$((BLOCKED + 1))
        continue
    fi
    if grep -qE '__attribute__[[:space:]]*\(\([[:space:]]*noreturn[[:space:]]*\)\)' "$f" 2>/dev/null; then
        echo -e "${RED}BLOCKED (FAKE): $f contains __attribute__((noreturn)) -- paired with byte injection${NC}"
        BLOCKED=$((BLOCKED + 1))
        continue
    fi

    # Check for non-empty inline asm: find all asm(...) and asm volatile(...) forms,
    # then filter out lines where the first token inside the parens is either an
    # empty string "" (compiler memory/ordering barrier, emits zero instructions)
    # or a register name like "r9" / "r31" (register-pinning binding, per
    # feedback_register_asm_policy.md 2026-04-18 — LEGAL, not codegen).
    # This catches real inline asm like asm("mr r3,r4"), asm volatile("li r0,1"),
    # while permitting:
    #   asm volatile("" ::: "memory")          — barrier
    #   asm("")                                 — barrier
    #   register int x asm("r31")               — register binding
    # Word-boundary (^|[^a-zA-Z0-9_]) required so test_bad_asm (4b) in a comment
    # or identifier doesn't spuriously match.
    if grep -nE '(^|[^a-zA-Z0-9_])asm[[:space:]]*(volatile[[:space:]]*)?\(' "$f" 2>/dev/null | \
       grep -vE '(^|[^a-zA-Z0-9_])asm[[:space:]]*(volatile[[:space:]]*)?\([[:space:]]*"(|r[0-9]+)"' > /dev/null; then
        echo -e "${RED}BLOCKED (FAKE): $f contains non-empty inline asm${NC}"
        echo -e "${RED}    Only the following asm forms are allowed:${NC}"
        echo -e "${RED}        asm volatile(\"\" ::: \"memory\")    — compiler barrier${NC}"
        echo -e "${RED}        register int x asm(\"r9\")         — register pinning${NC}"
        echo -e "${RED}    Any asm with instructions inside the string is forbidden.${NC}"
        BLOCKED=$((BLOCKED + 1))
        continue
    fi

    # Check for NON_MATCHING / NOT MATCHED markers in header
    if head -5 "$f" | grep -qiE 'NON.MATCHING|NOT MATCHED'; then
        echo -e "${RED}BLOCKED: $f is marked as non-matching${NC}"
        BLOCKED=$((BLOCKED + 1))
        continue
    fi

    parse_header "$f"

    # Fallback: extract address from filename (match_0xADDR_*.cpp) when header
    # lacks one. Size CANNOT be recovered this way and remains mandatory.
    if [ -z "$ADDR" ]; then
        FILENAME_ADDR=$(basename "$f" | grep -oE '0x[0-9A-Fa-f]{8}' | head -1)
        if [ -n "$FILENAME_ADDR" ]; then
            ADDR="$FILENAME_ADDR"
        fi
    fi

    if [ -z "$ADDR" ] || [ -z "$SIZE" ]; then
        echo -e "${RED}BLOCKED (HEADER): $f -- can't parse addr/size from first 5 lines${NC}"
        if [ -z "$SIZE" ]; then
            echo -e "${RED}    MISSING SIZE: first 5 lines must contain (NN B), (NN b), or '12 bytes' form.${NC}"
            echo -e "${RED}    This is QA-RULE #1 — size header is MANDATORY for verify_match.sh.${NC}"
        fi
        if [ -z "$ADDR" ]; then
            echo -e "${RED}    MISSING ADDRESS: no 0xXXXXXXXX found in header or filename.${NC}"
        fi
        echo -e "${RED}    Required canonical form (use exactly):${NC}"
        echo -e "${RED}      // 0x8012953C ClassName::method(args) (NN B)${NC}"
        BLOCKED=$((BLOCKED + 1))
        continue
    fi

    # Run verify_match.sh
    if [ ! -f "tools/verify_match.sh" ]; then
        # No verify tool -- can't enforce, allow through (legacy behavior)
        CHECKED=$((CHECKED + 1))
        continue
    fi

    VERIFY_OUT=$(bash tools/verify_match.sh --strict "$f" "$ADDR" "$SIZE" 2>&1)
    VERIFY_RC=$?

    # Success
    if [ $VERIFY_RC -eq 0 ] && echo "$VERIFY_OUT" | grep -q "^MATCH! Function"; then
        CHECKED=$((CHECKED + 1))
        continue
    fi

    # Compile failure -- BLOCK (broken source)
    if echo "$VERIFY_OUT" | grep -qE 'COMPILE FAILED|undeclared|: In function|invalid use|parse error|stray'; then
        echo -e "${RED}BLOCKED (COMPILE_FAIL): $f does not compile with SN ProDG${NC}"
        echo "$VERIFY_OUT" | grep -E 'undeclared|: In function|invalid use|parse error|COMPILE FAILED|stray' | head -5 | sed 's/^/    /'
        BLOCKED=$((BLOCKED + 1))
        continue
    fi

    # MISMATCH or SIZE_MISMATCH: handling depends on whether file is already tracked
    if echo "$VERIFY_OUT" | grep -qE 'MISMATCH|SIZE_MISMATCH'; then
        # If file is already tracked in git (i.e., this is a MODIFICATION of an
        # existing committed match), DO NOT silently move it. That caused the
        # Session 9 bulk-sweep bug where sibling-file edits changed compiler
        # state and quietly evicted established matches from src/matched/.
        # Instead, BLOCK and let the author investigate.
        if git ls-files --error-unmatch "$f" >/dev/null 2>&1; then
            echo -e "${RED}BLOCKED (MISMATCH on tracked file): $f${NC}"
            echo -e "${RED}    Previously-committed match no longer verifies — source or sibling${NC}"
            echo -e "${RED}    changes likely broke it. Investigate and fix, or unstage and${NC}"
            echo -e "${RED}    manually move to src/wip/version_diff/ if obsolete.${NC}"
            echo "$VERIFY_OUT" | tail -3 | sed 's/^/    /'
            BLOCKED=$((BLOCKED + 1))
            continue
        fi
        # Newly-added file that doesn't verify: auto-move to wip/version_diff/
        # (preserves the work, keeps src/matched/ clean)
        BASENAME=$(basename "$f")
        DEST="src/wip/version_diff/$BASENAME"
        cp "$f" "$DEST"
        git reset HEAD "$f" >/dev/null 2>&1 || true
        git rm --cached "$f" >/dev/null 2>&1 || true
        git add "$DEST" >/dev/null 2>&1
        echo -e "${CYAN}MOVED: $f -> $DEST (VERSION_DIFF -- preserved for later)${NC}"
        MOVED=$((MOVED + 1))
        continue
    fi

    # Unknown verify outcome -- block to be safe
    echo -e "${RED}BLOCKED (UNKNOWN): $f verify_match.sh exited $VERIFY_RC with no clear status${NC}"
    echo "$VERIFY_OUT" | tail -5 | sed 's/^/    /'
    BLOCKED=$((BLOCKED + 1))
done

echo -e "${GREEN}[pre-commit] Checked $CHECKED match files${NC}"
if [ $MOVED -gt 0 ]; then
    echo -e "${CYAN}[pre-commit] Moved $MOVED VERSION_DIFF file(s) to src/wip/version_diff/${NC}"
fi

if [ $BLOCKED -gt 0 ]; then
    echo -e "${RED}[pre-commit] BLOCKED $BLOCKED file(s)${NC}"
    echo -e "${RED}[pre-commit] Fix the files above, or set SKIP_VERIFY=1 to bypass (logged)${NC}"
    exit 1
fi

# report.json regeneration intentionally runs after a matcher batch, outside
# this index-locked critical path. Auditor-Coord commits that report separately.

exit 0
